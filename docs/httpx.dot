digraph "httpx" {
    rankdir=TB;
    node [shape=box, fontname="Helvetica"];
    "httpx" [style=filled, fillcolor="#cfe2ff"];
    "httpx" -> "anyio";
    "httpx" -> "certifi";
    "httpx" -> "httpcore";
    "httpx" -> "idna";
    "anyio" -> "exceptiongroup";
    "anyio" -> "idna";
